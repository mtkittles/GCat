      "font-display": {
        "$type": "other",
        "$value": "var(--font-sora), Sora, Inter, system-ui, sans-serif",
        "$description": "nagłówki h1–h3, tytuły rysunków (Sora)"
      },
      "font-mono": {
        "$type": "other",
        "$value": "var(--font-jetbrains), \"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
        "$description": "G-kod, kod inline, liczby w rysunkach (JetBrains Mono)"
      }
