      "cm-g01": {
        "$type": "color",
        "$value": "#15803D",
        "$extensions": {
          "gcat.dark": "#4ADE80"
        },
        "$description": "G01 w edytorze"
      },
      "cm-g02": {
        "$type": "color",
        "$value": "#0369A1",
        "$extensions": {
