# Adres produkcyjny (sitemap, robots, OpenGraph). Na Vercel może zostać pusty — użyje VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Konto użytkownika (Supabase). Puste = strona działa bez konta, postęp w przeglądarce.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usuwanie konta (tylko serwer, route handler /api/konto/usun). Klucz service_role z Supabase.
# BEZ prefiksu NEXT_PUBLIC_ — nigdy nie trafia do przeglądarki. Puste = przycisk „Usuń konto” pokazuje komunikat.
SUPABASE_SERVICE_ROLE_KEY=

# Panel treści Keystatic (/keystatic) na produkcji — GitHub App (instrukcja: docs/keystatic.md).
# Lokalnie (npm run dev) niepotrzebne: panel zapisuje prosto na dysk.
# Tylko serwer (bez NEXT_PUBLIC_): ID i sekret aplikacji oraz losowy sekret do szyfrowania sesji.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Jawny slug aplikacji (z adresu github.com/apps/<slug>) — panel pokazuje link do instalacji.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
