# Adres produkcyjny (sitemap, robots, OpenGraph). Na Vercel może zostać pusty — użyje VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Konto użytkownika (Supabase). Puste = strona działa bez konta, postęp w przeglądarce.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usuwanie konta (tylko serwer, route handler /api/konto/usun). Klucz service_role z Supabase.
# BEZ prefiksu NEXT_PUBLIC_ — nigdy nie trafia do przeglądarki. Puste = przycisk „Usuń konto” pokazuje komunikat.
SUPABASE_SERVICE_ROLE_KEY=
